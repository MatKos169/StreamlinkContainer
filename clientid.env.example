# Twitch Developer Portal app credentials (https://dev.twitch.tv/console/apps).
# Used by the recorder for the live/category checks.
TWITCH_CLIENT_ID=XxX
TWITCH_CLIENT_SECRET=XxX

# Optional: Twitch browser "auth-token" cookie, so Turbo/subscriptions apply
# (ad-free recordings). Treat it like a password.
# TWITCH_OAUTH_TOKEN=XxX
