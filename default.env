# Time zone for file names and logs.
TZ=Europe/Berlin
# Seconds between Twitch checks (one API call covers up to 100 channels).
CHECK_INTERVAL=60
# Quality used when a channel has none set, e.g. "1080p60,720p60,best".
DEFAULT_QUALITY=best
# Who may open the web UI: comma-separated IPs and/or networks.
ALLOWED_NETWORKS=10.0.0.0/24,127.0.0.1
