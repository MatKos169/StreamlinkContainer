# Time zone for file names and logs.
TZ=Europe/Berlin
# Defaults; check interval, quality and re-check can be changed in the web UI.
# Seconds between Twitch checks (one API call covers up to 100 channels).
CHECK_INTERVAL=60
# Quality used when a channel has none set, e.g. "1080p60,720p60,best".
DEFAULT_QUALITY=best
# After a stream ends, re-check the channel every RESCAN_INTERVAL seconds for
# RESCAN_DURATION seconds, so a stream that comes back after a dropout is picked
# up quickly (0 disables it).
RESCAN_INTERVAL=10
RESCAN_DURATION=120
# Who may open the web UI: comma-separated IPs and/or networks.
ALLOWED_NETWORKS=10.0.0.0/24,127.0.0.1
