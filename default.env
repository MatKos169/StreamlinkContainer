# Time zone for file names and logs.
TZ=Europe/Berlin
# Defaults; check interval, quality and re-check can be changed in the web UI.
# Seconds between Twitch checks (one API call covers up to 100 channels).
CHECK_INTERVAL=60
# Quality used when a channel has none set, e.g. "1080p60,720p60,best".
DEFAULT_QUALITY=best
# After a stream ends, re-check the channel every RESCAN_INTERVAL seconds for
# RESCAN_DURATION seconds, so a stream that comes back after a dropout is picked
# up quickly (0 disables it).
RESCAN_INTERVAL=10
RESCAN_DURATION=120
# Output (also in the web UI): folder layout output_year_month (name-2026/11/),
# year_month (name/2026/11/), year, date or none; keep the recorded .ts in
# /work/done after converting; normalize audio (loudnorm -14 LUFS, AAC 192k).
FOLDER_LAYOUT=output_year_month
KEEP_SOURCE=true
# Delete kept originals in /work/done after this many days (0 = never).
DONE_RETENTION_DAYS=0
AUDIO_NORMALIZE=true
# Video codec for the MP4 (copy = no re-encoding) and extra ffmpeg output options
# appended before the output file, e.g. FFMPEG_ARGS=-crf 23 -preset medium
VIDEO_CODEC=copy
FFMPEG_ARGS=
# VOD downloads (also in the web UI): realtime = paced to playback speed x VOD_SPEED
# (saves bandwidth and load on Twitch), download = as fast as possible with
# VOD_SEGMENT_THREADS parallel segment downloads; VOD_PARALLEL downloads at once.
VOD_MODE=realtime
VOD_SPEED=1
VOD_SEGMENT_THREADS=3
VOD_PARALLEL=1
# Max. Twitch streams at once (live recordings + VOD downloads). When reached,
# no new VOD download starts; live recordings always run. 0 = no limit.
MAX_PARALLEL_STREAMS=0
# Who may open the web UI: comma-separated IPs and/or networks.
ALLOWED_NETWORKS=10.0.0.0/24,127.0.0.1
